<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bodyweight Squats"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTargetMuscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quadriceps"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#EFF6FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvSetsReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sets: 3 | Reps: 15"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rest: 60s"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instructions:"
            android:textColor="#1E293B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lower hips until thighs parallel to ground, push back up."
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Common Mistakes:"
            android:textColor="#991B1B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMistakes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Knees collapsing inward, heels lifting off floor."
            android:textColor="#7F1D1D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Tip:"
            android:textColor="#065F46"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep chest lifted, pull shoulders back."
            android:textColor="#064E3B"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
