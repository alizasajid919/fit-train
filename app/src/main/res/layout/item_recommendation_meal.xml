<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Circular Emoji Container -->
            <FrameLayout
                android:id="@+id/flEmojiContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circular_gradient_light"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/tvMealEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🍳"
                    android:textSize="24sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMealType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breakfast"
                        android:textColor="#4F46E5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_primary_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvMealCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="350 kcal"
                        android:textColor="#1D4ED8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMealName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Greek Yogurt Parfait"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Macros Breakdown Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMealProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P: 25g"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#F1F5F9"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvMealCarbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C: 40g"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#F1F5F9"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvMealFat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F: 12g"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#F1F5F9"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvMealFiber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fb: 5g"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#F1F5F9"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginVertical="10dp" />

        <!-- Portions & Serving -->
        <TextView
            android:id="@+id/tvMealPortions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portion: 150g yogurt, 30g granola | Serving: 1 Bowl"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Ingredients List -->
        <TextView
            android:id="@+id/tvMealIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients: Greek yogurt, raw honey, berry granola"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Description/Preparation -->
        <TextView
            android:id="@+id/tvMealDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Layer yogurt, granola, and berries in a glass."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
