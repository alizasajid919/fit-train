<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#BFDBFE"
    app:strokeWidth="1.2dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left color stripe representing meal type -->
        <View
            android:id="@+id/vMealAccentStripe"
            android:layout_width="5dp"
            android:layout_height="80dp"
            android:background="@color/primary"
            android:layout_gravity="center_vertical" />

        <!-- Meal Thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ivMealImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvMealEmoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="34sp"
                    android:textColor="@color/black"
                    android:text="🍳"
                    android:visibility="visible" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Meal Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginVertical="12dp">

            <TextView
                android:id="@+id/tvMealType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BREAKFAST"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMealName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oatmeal with Berries"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMealIngredients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients: Oats, Milk, Blueberries"
                android:textColor="@color/gray"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMealDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cook oats, top with honey and berries."
                android:textColor="@color/light_gray"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Macros Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvMealProt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3B82F6"
                    android:textSize="11sp"
                    android:text="P: 0g" />

                <TextView
                    android:id="@+id/tvMealCarbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:text="C: 0g" />

                <TextView
                    android:id="@+id/tvMealFat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:text="F: 0g" />

                <TextView
                    android:id="@+id/tvMealAiRec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#8B5CF6"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="★ Recommendation" />
            </LinearLayout>

            <!-- View Full Recipe Action -->
            <TextView
                android:id="@+id/btnViewFullRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="View Full Recipe ➔"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />


        </LinearLayout>

        <!-- Right Side Controls (Calories & Icons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvMealCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450 kcal"
                android:textColor="#E91E63"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_calories"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_gravity="end" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/ivMealFavorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_heart_fav"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Favorite icon" />

                <ImageView
                    android:id="@+id/ivDeleteMeal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete logged food"
                    app:tint="#EF4444" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
