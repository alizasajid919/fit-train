<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".activities.RealTimeFeedbackActivity">

    <!-- Header Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E293B"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="AI Posture Guidance Hub"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Viewport: Camera & Pose Overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/cvMetricsContainer">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/pvCameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pose Drawing Overlay -->
            <com.fitness.app.views.PoseOverlayView
                android:id="@+id/ovPoseOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- HUD Floating Feedback Overlay -->
            <LinearLayout
                android:id="@+id/llHudFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:background="#E61E293B"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:elevation="4dp"
                android:clipToPadding="false">

                <View
                    android:id="@+id/vStatusIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_badge_streak"
                    android:backgroundTint="#2563EB"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPostureStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correct Form"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Loading State Overlay -->
            <LinearLayout
                android:id="@+id/llLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CC0F172A"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="#6366F1" />

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Preparing Pose Detection..."
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Error State Card Layout -->
            <LinearLayout
                android:id="@+id/llErrorLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F20F172A"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/stat_notify_error"
                    app:tint="#EF4444" />

                <TextView
                    android:id="@+id/tvErrorDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Camera permission or device is unavailable."
                    android:textColor="#CBD5E1"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_gradient"
                    android:paddingHorizontal="24dp"
                    android:text="Retry Setup"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Squats Rep counter & Score Metrics Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvMetricsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rep & Stage section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REPS"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRepCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 15"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SETS"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSetCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 3"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STAGE"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSquatStage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standing"
                        android:textColor="#3B82F6"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="12dp" />

            <!-- Score metrics grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FORM SCORE"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverallScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#2563EB"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <GridLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <TextView android:id="@+id/tvAccuracyVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accuracy: 0%" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_margin="2dp" />
                    <TextView android:id="@+id/tvDepthVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Depth: 0%" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_margin="2dp" />
                    <TextView android:id="@+id/tvBalanceVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Balance: 0%" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_margin="2dp" />
                    <TextView android:id="@+id/tvStabilityVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stability: 0%" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_margin="2dp" />
                    <TextView android:id="@+id/tvPostureVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Posture: 0%" android:textColor="#CBD5E1" android:textSize="12sp" android:layout_margin="2dp" />
                </GridLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="12dp" />

            <!-- Dynamic Recommendation Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOMMENDATION"
                    android:textColor="#3B82F6"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFeedbackTips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Step back 2-3 meters and position your entire body in the camera frame to start analysis."
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Buttons control -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleScan"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_gradient"
                    android:text="Pause Tracking"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFinishSession"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_gradient"
                    android:backgroundTint="#6366F1"
                    android:text="Finish Workout"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
