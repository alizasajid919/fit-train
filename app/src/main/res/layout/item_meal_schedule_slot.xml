<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#DBEAFE"
    app:strokeWidth="1.2dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header Row: Category Tag, Time, Checkmark, Favorite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BREAKFAST"
                android:textColor="@color/primary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_primary_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 AM"
                android:textColor="#64748B"
                android:textSize="11.5sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvTitleCheckmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✅ Eaten"
                android:textColor="#2563EB"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivFavoriteSlot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_heart_fav"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite" />
        </LinearLayout>

        <!-- Middle Content Row: Food Image + Meal Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Food Image / Emoji Thumbnail Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#EFF6FF"
                android:layout_marginEnd="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivMealImageSlot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMealEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="32sp"
                        android:textColor="@color/black"
                        android:text="🍳"
                        android:visibility="visible" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Text Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oatmeal with Fresh Berries"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSlotDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oats, almond milk, blueberries, honey"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Macros Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvSlotProt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P: 18g"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSlotCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="C: 45g"
                        android:textColor="#06B6D4"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tvSlotFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="F: 8g"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Calories Badge -->
            <TextView
                android:id="@+id/tvCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="350 kcal"
                android:textColor="#E11D48"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_calories"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Action Row: Checkmark / Mark Eaten + View Recipe CTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Checkbox / Toggle Eaten Button -->
            <CheckBox
                android:id="@+id/cbMarkEaten"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Mark Eaten"
                android:textColor="#334155"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:buttonTint="@color/primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- View Recipe CTA Button -->
            <TextView
                android:id="@+id/btnViewFullRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Recipe ➔"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <!-- Stub arrow to preserve R.id lookup -->
            <ImageView
                android:id="@+id/btnNavigateDetail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
