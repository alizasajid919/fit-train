<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".activities.HelpActivity">

    <!-- App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_blue_gradient"
        app:titleTextColor="@color/white"
        app:title="Help Center"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search Bar Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="#64748B" />

            <EditText
                android:id="@+id/etHelpSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Search FAQ or topics..."
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardSearch">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Expandable FAQ Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequently Asked Questions"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- FAQ Card 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I start my first workout?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Navigate to the Workouts screen using the bottom navigation bar. Select a featured card like '🚀 NEW TO FITTRAIN? START HERE!' or generate a daily personalized routine."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How does the AI Coach work?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The AI Coach automatically analyzes your registered physical details, height, weight, BMI, and calorie targets, generating healthy tips."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Can I customize generated workouts?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Yes, you can specify your available equipment and fitness goals under Settings or run the custom generator on the workouts screen to modify exercises."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I log daily nutrition and water?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow4"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Go to the Diet tab to see your recommended diet plan. You can view meal details, log nutrition inputs, and consult calorie tracking."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 5 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I sync local data to the cloud?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow5"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Go to Settings, select 'Link Account / Create Account'. Registering an email links your offline logs to the cloud instantly."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 6 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I use the Smart Grocery Scanner?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow6"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Navigate to the Grocery Scanner from the dashboard. Tap 'Scan Ingredients' to scan a food label. The AI will instantly analyze its healthiness, flag allergen matches, and recommend healthy recipes."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 7 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="What does the full-screen Nutrition Summary show?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow7"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap 'Nutrition Summary' in the Diet menu to view your detailed macronutrient progress (Carbs, Protein, Fat), rolling weekly averages, other tracked nutrients (Fiber, Sugar, Sodium, Water), dynamic macro source breakdowns, and custom AI Coach tips."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 8 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I track my Body Transformation progress?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow8"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open the Transformation Hub from the side menu. Upload front/side photos, update your current weight, calculate your body mass index (BMI), set target goals, and monitor your muscle or fat loss changes on the timeline."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 9 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I complete my generated daily meals?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow9"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap any meal card in your Diet Schedule to view its details (recipe description, ingredients, prep steps). Tap the 'Mark as Completed' button to log the calories and sync the meal checklist. You will see a green checkmark check off on the schedule."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ Card 10 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/faqCard10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/faqHeader10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I customize my workout equipment and levels?"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/faqArrow10"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/faqBody10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Navigate to the Workouts generator and select 'Custom Workout Options'. Specify your experience level (Beginner, Intermediate, Advanced) and select your available equipment (Bodyweight, Dumbbells, Kettlebells, or Full Gym) to tailor your routine."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contact & Form Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Support &amp; Feedback"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/white">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Your Contact Email"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHelpEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#1E293B"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Support Ticket Type"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/primary">

                        <AutoCompleteTextView
                            android:id="@+id/etHelpType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="#1E293B"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Message or Bug Description"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHelpMessage"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:textColor="#1E293B"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitFeedback"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Submit Request"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:backgroundTint="@color/primary"
                        android:textAllCaps="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
