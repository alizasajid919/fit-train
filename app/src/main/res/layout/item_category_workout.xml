<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#BFDBFE"
    app:strokeWidth="1.2dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Workout Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/ivWorkoutImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/onboarding_1" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvWorkoutTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Body Shred"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWorkoutDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A high intensity workout designed to challenge every major muscle group."
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <!-- Duration Badge -->
                    <TextView
                        android:id="@+id/tvWorkoutDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 min"
                        android:textColor="#1E40AF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_duration"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:layout_marginEnd="4dp" />

                    <!-- Difficulty Badge -->
                    <TextView
                        android:id="@+id/tvWorkoutDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intermediate"
                        android:textColor="#15803D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_beginner"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:layout_marginEnd="4dp" />

                    <!-- Calories Badge -->
                    <TextView
                        android:id="@+id/tvWorkoutCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="220 kcal"
                        android:textColor="#E91E63"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_calories"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:ellipsize="none" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStartWorkout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Start Workout"
                android:background="@drawable/bg_button_gradient"
                app:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <ProgressBar
                android:id="@+id/pbStartWorkout"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
