<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.TakePhotoActivity">

    <!-- Camera PreviewView for live CameraX preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top App Bar (Overlaid on camera feed with semi-transparent background) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#60000000"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Take Photo"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Center Pose Guide Silhouette Outline Overlay -->
    <ImageView
        android:id="@+id/ivPoseGuideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="32dp"
        android:alpha="0.45"
        android:scaleType="fitCenter"
        android:src="@drawable/pose_guide_silhouette"
        app:layout_constraintBottom_toTopOf="@id/bottomControlContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Bottom Controls & Pose Selection Container -->
    <LinearLayout
        android:id="@+id/bottomControlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B0000000"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Shutter & Flash & Flip bar (pill-shaped semi-transparent container) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_bottom_sheet"
            android:backgroundTint="#CCFFFFFF"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp">

            <!-- Flash trigger -->
            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Flash Settings"
                android:src="@drawable/ic_flash"
                app:tint="@color/black" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Magenta Shutter -->
            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF4081"
                android:contentDescription="Capture"
                android:src="@drawable/ic_camera"
                app:tint="@color/white"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Flip camera trigger -->
            <ImageButton
                android:id="@+id/btnFlip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Flip Camera"
                android:src="@drawable/ic_camera_flip"
                app:tint="@color/black" />

        </LinearLayout>

        <!-- Angle Thumbnails row label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Pose Angle Guide"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- 4 Pose guide angle thumbnails -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <!-- Card 1: Front -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnPoseFront"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#66FFFFFF">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/progress_fit_front" />
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Back -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnPoseBack"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#22FFFFFF">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/progress_fit_back" />
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Left -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnPoseLeft"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#22FFFFFF">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/progress_fit_left" />
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Right -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnPoseRight"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#22FFFFFF">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/progress_fit_right" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
