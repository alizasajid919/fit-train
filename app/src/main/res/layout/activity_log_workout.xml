<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workout_background">

    <!-- AppBar & Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/workout_primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Log a Workout"
            app:titleTextColor="@color/workout_white"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/workout_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:focusable="true">

            <!-- Featured Workout Header Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvFeaturedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/workout_white"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Left Text Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/tvFeaturedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Body Shred"
                            android:textColor="@color/workout_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFeaturedStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25 Mins • Intermediate • 240 kcal"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvFeaturedDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High intensity intervals to burn fat and build endurance."
                            android:textColor="@color/workout_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="1.5dp" />

                    </LinearLayout>

                    <!-- Right Illustration Image -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivFeaturedIllustration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/onboarding_2" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Title Header -->
            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record Exercise"
                android:textColor="@color/workout_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Exercise Name Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExerciseName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Exercise Name"
                android:textColorHint="@color/workout_text_secondary"
                app:startIconDrawable="@drawable/ic_dumbbell"
                app:startIconTint="@color/workout_secondary"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/workout_primary"
                app:boxStrokeWidthFocused="2dp"
                app:errorIconDrawable="@null"
                app:errorTextColor="@color/workout_error"
                app:boxStrokeErrorColor="@color/workout_error"
                app:hintTextColor="@color/workout_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExerciseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Row for Sets and Reps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:weightSum="2">

                <!-- Sets Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSets"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="Sets"
                    android:textColorHint="@color/workout_text_secondary"
                    app:startIconDrawable="@drawable/ic_sets"
                    app:startIconTint="@color/workout_secondary"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/workout_primary"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorIconDrawable="@null"
                    app:errorTextColor="@color/workout_error"
                    app:boxStrokeErrorColor="@color/workout_error"
                    app:hintTextColor="@color/workout_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reps Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReps"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="Reps"
                    android:textColorHint="@color/workout_text_secondary"
                    app:startIconDrawable="@drawable/ic_reps"
                    app:startIconTint="@color/workout_secondary"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/workout_primary"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorIconDrawable="@null"
                    app:errorTextColor="@color/workout_error"
                    app:boxStrokeErrorColor="@color/workout_error"
                    app:hintTextColor="@color/workout_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Weight Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWeight"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Weight (kg)"
                android:textColorHint="@color/workout_text_secondary"
                app:startIconDrawable="@drawable/ic_weight"
                app:startIconTint="@color/workout_secondary"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/workout_primary"
                app:boxStrokeWidthFocused="2dp"
                app:errorIconDrawable="@null"
                app:errorTextColor="@color/workout_error"
                app:boxStrokeErrorColor="@color/workout_error"
                app:hintTextColor="@color/workout_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Notes Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:hint="Notes (Optional)"
                android:textColorHint="@color/workout_text_secondary"
                app:startIconDrawable="@drawable/ic_notes"
                app:startIconTint="@color/workout_secondary"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/workout_primary"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/workout_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="4"
                    android:textColor="@color/black"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Live Character Counter -->
            <TextView
                android:id="@+id/tvNotesCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0 / 200"
                android:textColor="@color/workout_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="4dp" />

            <!-- Workout History (Optional) Collapsible Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvHistorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/workout_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Toggle Area -->
                    <LinearLayout
                        android:id="@+id/btnToggleHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_history"
                            app:tint="@color/workout_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Workout History (Optional)"
                            android:textColor="@color/workout_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivHistoryArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/workout_text_secondary" />
                    </LinearLayout>

                    <!-- Collapsible History Body -->
                    <LinearLayout
                        android:id="@+id/layoutHistoryBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/workout_border"
                            android:layout_marginBottom="8dp" />

                        <!-- Empty State -->
                        <LinearLayout
                            android:id="@+id/layoutEmptyHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💪"
                                android:textSize="36sp"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No workout history yet"
                                android:textColor="@color/workout_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- History List -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvWorkoutHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="200dp"
                            tools:listitem="@layout/item_workout_history" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Add to Calendar Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/workout_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/workout_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Add to Calendar"
                            android:textColor="@color/workout_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCalendar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/workout_secondary"
                            app:trackTint="#BFDBFE" />
                    </LinearLayout>

                    <!-- Date Selection Display -->
                    <LinearLayout
                        android:id="@+id/layoutDateSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="8dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/workout_border"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/btnSelectDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_edittext"
                            android:backgroundTint="#F5F5F5"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Select Workout Date"
                                android:textColor="@color/workout_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvSelectedDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:textColor="@color/workout_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/workout_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Premium Save Button Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save Workout"
                    android:textColor="@color/workout_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_gradient"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    android:elevation="4dp"
                    android:clickable="false"
                    android:enabled="false"
                    android:stateListAnimator="@null" />

                <!-- Loading Animation (Spinner) -->
                <ProgressBar
                    android:id="@+id/pbSavingProgress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/workout_white"
                    android:visibility="gone" />

                <!-- Success Animation Checkmark -->
                <com.fitness.app.views.SuccessCheckmarkView
                    android:id="@+id/successCheckmark"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
