<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121A">

    <!-- Header Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/cropToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E2E"
        app:title="Crop Profile Photo"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Container for Image and Mask Overlay -->
    <FrameLayout
        android:id="@+id/cropContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0A0A0F"
        app:layout_constraintBottom_toTopOf="@+id/layoutActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cropToolbar">

        <!-- ImageView with Scale Type Matrix for Drag & Pinch Gestures -->
        <ImageView
            android:id="@+id/ivCropImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:contentDescription="Crop Area" />

        <!-- Circular Overlay Cutout View -->
        <com.fitness.app.activities.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom Actions Control Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1E1E2E"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCropCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#9E9E9E"
            android:textSize="16sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintEnd_toStartOf="@+id/btnCropRotate"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rotate Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCropRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Rotate Image"
            app:fabSize="mini"
            app:backgroundTint="#2E2E3E"
            app:srcCompat="@android:drawable/ic_menu_rotate"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnCropDone"
            app:layout_constraintStart_toEndOf="@+id/btnCropCancel"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Done/Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCropDone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Done"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="24dp"
            android:backgroundTint="#6C63FF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.9"
            app:layout_constraintStart_toEndOf="@+id/btnCropRotate"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
