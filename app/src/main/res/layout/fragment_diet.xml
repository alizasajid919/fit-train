<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".fragments.DietFragment">

    <!-- Top Toolbar Header (Fixed at the Top) -->
    <LinearLayout
        android:id="@+id/llDietHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meal Planner"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your personalized meals for today"
                android:textColor="#64748B"
                android:textSize="11.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Settings Icon Button -->
        <ImageView
            android:id="@+id/ivDietMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_tune"
            app:tint="#2563EB"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Continuous Scrollable Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvDietScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llDietHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 1. Today's Nutrition Summary Card (Blue + White Dashboard) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDietSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1.2dp"
                app:strokeColor="#DBEAFE"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TODAY'S NUTRITION"
                                android:textColor="#2563EB"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTargetCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily Target: 2,000 kcal"
                                android:textColor="#0F172A"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvConsumedVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0 / 2,000 kcal"
                            android:textColor="#2563EB"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_primary_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </RelativeLayout>

                    <!-- Calorie Progress Bar -->
                    <ProgressBar
                        android:id="@+id/pbKcalProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:progressDrawable="@drawable/pb_meal_nutrition" />

                    <!-- Macros Split Pills Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">

                        <!-- Protein Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="10dp"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Protein 💪"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvProteinVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="140g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                            <TextView
                                android:id="@+id/tvProteinsVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 140g"
                                android:textColor="#64748B"
                                android:textSize="9.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <!-- Carbs Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="10dp"
                            android:layout_marginHorizontal="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbs 🌾"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvCarbsVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="220g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                            <TextView
                                android:id="@+id/tvCarbsValSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 220g"
                                android:textColor="#64748B"
                                android:textSize="9.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <!-- Fat Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="10dp"
                            android:layout_marginStart="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fat 🥑"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvFatVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="65g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                            <TextView
                                android:id="@+id/tvFatsVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 65g"
                                android:textColor="#64748B"
                                android:textSize="9.5sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. MAIN FEATURE: Daily Meal Schedule Container (Permanently Visible) -->
            <LinearLayout
                android:id="@+id/llExpandedSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_marginTop="16dp">

                <!-- Section Header: Month & More Options -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY'S MEAL SCHEDULE"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCalendarMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="May 2026"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btnScheduleMore"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_more_vert"
                        app:tint="#64748B"
                        android:contentDescription="More Options" />
                </LinearLayout>

                <!-- Mon-Sun Date Selector Bar -->
                <LinearLayout
                    android:id="@+id/layoutCalendarBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <!-- Day 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer1"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="M"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="11"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer2"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="T"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="12"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer3"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="W"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="13"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer4"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="T"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="14"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 5 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer5"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="F"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="15"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 6 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer6"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="16"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Day 7 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dayContainer7"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDay7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/tvDate7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="17"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Quick Category Filter Chips Bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Meals"
                            android:checked="true"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeColor="@color/chip_stroke_color_selector"
                            android:textColor="@color/chip_text_color_selector"
                            app:chipStrokeWidth="1.2dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterBreakfast"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Breakfast"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeColor="@color/chip_stroke_color_selector"
                            android:textColor="@color/chip_text_color_selector"
                            app:chipStrokeWidth="1.2dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterLunch"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunch"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeColor="@color/chip_stroke_color_selector"
                            android:textColor="@color/chip_text_color_selector"
                            app:chipStrokeWidth="1.2dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterDinner"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dinner"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeColor="@color/chip_stroke_color_selector"
                            android:textColor="@color/chip_text_color_selector"
                            app:chipStrokeWidth="1.2dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterSnacks"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Snacks"
                            app:chipBackgroundColor="@color/chip_background_selector"
                            app:chipStrokeColor="@color/chip_stroke_color_selector"
                            android:textColor="@color/chip_text_color_selector"
                            app:chipStrokeWidth="1.2dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Daily Schedule List RecyclerView (Main Feature) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvScheduleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="4dp" />

                <!-- Add Custom Meal Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMealSlot"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Add Meal ➕"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_gradient"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
