<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_gradient"
    tools:context=".fragments.DietFragment">

    <!-- Top Toolbar Header (Fixed at the Top) -->
    <LinearLayout
        android:id="@+id/llDietHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meal Planner"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Labeled / Clear Settings Icon Button -->
        <ImageView
            android:id="@+id/ivDietMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_tune"
            app:tint="#64748B"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Continuous Scrollable Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvDietScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llDietHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- [NEW] Smart Meal Planner Tip Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDietTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_premium_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Meal Tip: Use the AI Grocery Scanner to snap photos of groceries and generate matching recipes instantly!"
                        android:textColor="#334155"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp" />

                    <ImageView
                        android:id="@+id/ivDismissDietTip"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_close"
                        app:tint="#94A3B8"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 1. Smart Meal Planner Card (AI Grocery Scanner) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvSmartMealPlanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_blue_gradient">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥗 AI GROCERY SCANNER"
                                android:textColor="#E0F7FA"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart Meal Planner"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scan groceries to generate custom healthy meals instantly."
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:alpha="0.9"
                                android:layout_marginTop="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenMealPlanner"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Scan Groceries Now 📷"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="18dp"
                                app:backgroundTint="@android:color/white"
                                android:layout_marginTop="12dp"
                                android:textAllCaps="false" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_healthy_fitness_ai"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Nutrition Target Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDietSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                app:cardElevation="3dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_blue_gradient">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUTRITION TARGET"
                        android:textColor="#E0F7FA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargetCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Target: 2,000 kcal"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <!-- Macros Split Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">

                        <!-- Protein -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="8dp"
                            android:layout_marginHorizontal="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Protein"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvProteinVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="140g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Carbs -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="8dp"
                            android:layout_marginHorizontal="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbs"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvCarbsVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="220g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Fat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_duration"
                            android:paddingVertical="8dp"
                            android:layout_marginHorizontal="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fat"
                                android:textColor="#1E40AF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvFatVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="65g"
                                android:textColor="#1E40AF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Daily Meal Schedule Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMealScheduleBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1.2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Daily Meal Schedule"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCheckSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Check Schedule 📅"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button_gradient"
                        app:backgroundTint="@null"
                        android:textAllCaps="false"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. AI Suggestions / Saved Favorites Row -->
            <LinearLayout
                android:id="@+id/llDietFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="18dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllMeals"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Suggestions"
                    android:checked="true"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_color_selector"
                    android:textColor="@color/chip_text_color_selector"
                    app:chipStrokeWidth="1.2dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFavorites"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved Favorites"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_color_selector"
                    android:textColor="@color/chip_text_color_selector"
                    app:chipStrokeWidth="1.2dp" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/pbDietLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <!-- Meals List Layout -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDietMeals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Redesigned Smart Empty state placeholder -->
            <LinearLayout
                android:id="@+id/llNoFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                android:padding="20dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/onboarding_4"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/tvNoFavoritesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Favorites Saved"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap the heart icon on any recipe suggestion to save it here."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

                <!-- Smart Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Show AI Suggestions 🥗"
                    android:textColor="@android:color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@color/primary"
                    android:layout_marginTop="16dp"
                    android:textAllCaps="false"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
