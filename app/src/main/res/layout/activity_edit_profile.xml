<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".activities.EditProfileActivity">

    <!-- Gradient Header Background -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_blue_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar on Top of Gradient Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FitTrain Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable Form Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <!-- Floating Profile Card (White background, 20dp corners, 8dp elevation, 20dp horizontal margins, 20dp padding) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <!-- Profile Image (Circular size 110dp, 4dp white border, soft shadow) -->
                    <FrameLayout
                        android:layout_width="118dp"
                        android:layout_height="118dp"
                        android:layout_gravity="center_horizontal">
                        <androidx.cardview.widget.CardView
                            android:layout_width="118dp"
                            android:layout_height="118dp"
                            app:cardCornerRadius="59dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardElevation="4dp">
                            <androidx.cardview.widget.CardView
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                app:cardCornerRadius="55dp"
                                android:layout_gravity="center"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivEditProfilePic"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/onboarding_1" />
                            </androidx.cardview.widget.CardView>
                        </androidx.cardview.widget.CardView>
                        <!-- Camera Icon Badge on Bottom-Right -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnChangePic"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|end"
                            app:cardCornerRadius="16dp"
                            app:cardBackgroundColor="#6C63FF"
                            app:cardElevation="6dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- User Name: 28sp Bold, Dark Text -->
                    <TextView
                        android:id="@+id/tvEditProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guest User"
                        android:textColor="@color/black"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <!-- User Email: 16sp, Secondary Text -->
                    <TextView
                        android:id="@+id/tvEditProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="guest@fittrain.com"
                        android:textColor="@color/gray"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp" />

                    <!-- Badges Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Goal Badge: Background #DCFCE7, Text #15803D -->
                        <TextView
                            android:id="@+id/tvEditProfileGoalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Goal: Improve Shape"
                            android:textColor="#1E40AF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_goal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Streak Badge: Background #FEF3C7, Text #D97706 -->
                        <TextView
                            android:id="@+id/tvEditProfileStreakBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 3 Day Streak"
                            android:textColor="#D97706"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_streak"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRemovePic"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Remove Photo"
                        android:textColor="#EF4444"
                        android:backgroundTint="@color/white"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        android:padding="0dp"
                        android:textAllCaps="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Form Inputs (White background, 20dp corners, soft shadow) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Header: Personal Information 20sp Bold -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Information"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- First Name -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="First Name"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditFirstName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="textPersonName"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Last Name -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Last Name"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditLastName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="textPersonName"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Email -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_mail"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="textEmailAddress"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Mobile Number -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Mobile Number"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditMobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="phone"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Date of Birth -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date of Birth"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_calendar"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditDob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:focusable="false"
                                android:clickable="true"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Gender (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Gender"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditGender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Country (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Country"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_home"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditCountry"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- City -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="City"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_home"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditCity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="text"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Blood Group (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Blood Group"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditBloodGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Height -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Height (cm)"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_height"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditHeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="numberDecimal"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Weight -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Weight (kg)"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_weight"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditWeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="numberDecimal"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Fitness Goal (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Fitness Goal"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_dumbbell"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditGoal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Activity Level (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Activity Level"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_dumbbell"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditActivityLevel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Target Weight -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Target Weight (kg)"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_weight"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditTargetWeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="numberDecimal"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Diet Preference (Material Exposed Dropdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Diet Preference"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_diet"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <AutoCompleteTextView
                                android:id="@+id/etEditDietary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Medical Conditions -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Medical Conditions"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditConditions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="text"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Emergency Contact -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:backgroundTint="#FFFFFF">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Emergency Contact"
                            app:hintTextColor="#6C63FF"
                            android:textColorHint="#64748B"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#6C63FF"
                            app:boxStrokeColor="@color/text_input_stroke_color"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEditEmergency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:inputType="text"
                                android:background="@android:color/transparent" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Buttons: Cancel (Outlined Purple border) & Save Changes (Purple filled, height 56dp, ripple) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancel"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:text="Cancel"
                            android:textColor="#6C63FF"
                            app:strokeColor="#6C63FF"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="16dp"
                            android:textAllCaps="false"
                            android:layout_marginEnd="8dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1.2"
                            android:text="Save Changes"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#6C63FF"
                            app:cornerRadius="16dp"
                            android:elevation="4dp"
                            android:textAllCaps="false" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
