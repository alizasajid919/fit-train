<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".activities.DietPlannerActivity">

    <!-- Top Bar Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_blue_gradient"
        app:titleTextColor="@color/white"
        app:title="AI Diet &amp; Nutrition"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Redesigned Nutrition Summary Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvDietSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:background="@color/white">

            <!-- Left side: Calories Circular Ring -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="16dp">

                <ProgressBar
                    android:id="@+id/pbCircleProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="2000"
                    android:progress="600"
                    android:progressDrawable="@drawable/bg_circular_progress"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center">
                    <TextView
                        android:id="@+id/tvCaloriesVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="600"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTargetCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 2000 kcal"
                        android:textColor="@color/gray"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Right side: Macros Progress bars -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Protein -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Protein"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvProteinVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45g / 140g"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pbProtein"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:max="140"
                        android:progress="45"
                        android:progressTint="@color/primary" />
                </LinearLayout>

                <!-- Carbs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Carbs"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvCarbsVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90g / 220g"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pbCarbs"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:max="220"
                        android:progress="90"
                        android:progressTint="@color/secondary" />
                </LinearLayout>

                <!-- Fat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fat"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvFatVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25g / 65g"
                            android:textColor="#FFB703"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pbFat"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:max="65"
                        android:progress="25"
                        android:progressTint="#FFB703" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filters Row: Meal Schedule, Logged diary, Favorites -->
    <LinearLayout
        android:id="@+id/llDietFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cvDietSummary">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAllMeals"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Schedule"
            android:checked="true"
            app:chipBackgroundColor="@color/white"
            app:chipStrokeColor="#E2E8F0"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLoggedMeals"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logged Diary"
            app:chipBackgroundColor="@color/white"
            app:chipStrokeColor="#E2E8F0"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFavorites"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites"
            app:chipBackgroundColor="@color/white"
            app:chipStrokeColor="#E2E8F0" />
    </LinearLayout>

    <!-- Meals List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMeals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llDietFilters" />

    <!-- No data placeholder -->
    <LinearLayout
        android:id="@+id/llNoFavorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llDietFilters"
        app:layout_constraintBottom_toTopOf="@+id/btnRegeneratePlan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/onboarding_4"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/tvNoFavoritesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Logged Foods"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvNoFavoritesDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the FAB to log your meals"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Regenerate button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegeneratePlan"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Regenerate Meal Plan"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:backgroundTint="@color/primary"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Floating Action Button for custom meal logging -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMeal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toTopOf="@id/btnRegenerate"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Log a custom meal" />

</androidx.constraintlayout.widget.ConstraintLayout>
