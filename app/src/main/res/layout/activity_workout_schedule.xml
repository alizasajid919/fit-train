<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".activities.WorkoutScheduleActivity">

    <!-- Top Bar Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_blue_gradient"
        app:titleTextColor="@color/white"
        app:title="Workout Schedule"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Calendar Week Selector Header Row -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvCalendarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        android:backgroundTint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/llCalendarDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:weightSum="7">

            <!-- Sun -->
            <LinearLayout
                android:id="@+id/daySun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValSun" android:layout_width="32dp" android:layout_height="32dp" android:text="10" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Mon -->
            <LinearLayout
                android:id="@+id/dayMon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValMon" android:layout_width="32dp" android:layout_height="32dp" android:text="11" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tue -->
            <LinearLayout
                android:id="@+id/dayTue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValTue" android:layout_width="32dp" android:layout_height="32dp" android:text="12" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Wed -->
            <LinearLayout
                android:id="@+id/dayWed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValWed" android:layout_width="32dp" android:layout_height="32dp" android:text="13" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Thu -->
            <LinearLayout
                android:id="@+id/dayThu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValThu" android:layout_width="32dp" android:layout_height="32dp" android:text="14" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Fri -->
            <LinearLayout
                android:id="@+id/dayFri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValFri" android:layout_width="32dp" android:layout_height="32dp" android:text="15" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Sat -->
            <LinearLayout
                android:id="@+id/daySat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textSize="11sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDayValSat" android:layout_width="32dp" android:layout_height="32dp" android:text="16" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Hourly slots list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvScheduleSlots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cvCalendarRow"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- No schedules placeholder -->
    <LinearLayout
        android:id="@+id/llNoSchedules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cvCalendarRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/onboarding_4"
            android:alpha="0.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Scheduled Workouts"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the FAB (+) below to add a session"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- FAB for Add Schedule -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_dumbbell"
        app:tint="#FFFFFF"
        app:backgroundTint="#6C63FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
