<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.CompleteProfileActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingBottom="30dp">

            <!-- Top Illustration -->
            <ImageView
                android:id="@+id/ivCompleteProfileIllustration"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="fitCenter"
                android:src="@drawable/profile_complete"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="Profile Illustration" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvCompleteProfileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/complete_profile_title"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivCompleteProfileIllustration" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvCompleteProfileSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/complete_profile_subtitle"
                android:textColor="@color/gray"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCompleteProfileTitle" />

            <!-- Profile Image Picker Container -->
            <FrameLayout
                android:id="@+id/flProfileImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCompleteProfileSubtitle">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user"
                    android:padding="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/primary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

                <!-- Camera badge -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddPhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:backgroundTint="@color/secondary"
                    app:backgroundTint="@color/secondary"
                    android:src="@android:drawable/ic_menu_camera"
                    app:fabSize="mini"
                    app:borderWidth="0dp"
                    app:elevation="2dp"
                    android:contentDescription="Add photo"
                    app:tint="@color/white" />

            </FrameLayout>

            <!-- Form Container -->
            <LinearLayout
                android:id="@+id/llForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/flProfileImage">

                <!-- Gender Dropdown -->
                <LinearLayout
                    android:id="@+id/containerGender"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Gender" />

                    <Spinner
                        android:id="@+id/spGender"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please select a gender" />

                <!-- Date of Birth -->
                <EditText
                    android:id="@+id/etDob"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="12dp"
                    android:hint="@string/date_of_birth"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/light_gray"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/tvErrorDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please enter a valid date of birth" />

                <!-- Weight Input -->
                <LinearLayout
                    android:id="@+id/containerWeight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_weight"
                        android:contentDescription="Weight" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/your_weight"
                        android:inputType="numberDecimal"
                        android:textColor="@color/black"
                        android:textColorHint="@color/light_gray"
                        android:textSize="14sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KG"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please enter a valid weight" />

                <!-- Height Input -->
                <LinearLayout
                    android:id="@+id/containerHeight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_height"
                        android:contentDescription="Height" />

                    <EditText
                        android:id="@+id/etHeight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/your_height"
                        android:inputType="numberDecimal"
                        android:textColor="@color/black"
                        android:textColorHint="@color/light_gray"
                        android:textSize="14sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CM"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please enter a valid height" />

                <!-- Activity Level Dropdown -->
                <LinearLayout
                    android:id="@+id/containerActivityLevel"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Activity Level" />

                    <Spinner
                        android:id="@+id/spActivityLevel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorActivityLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please select an activity level" />

                <!-- Country Dropdown -->
                <LinearLayout
                    android:id="@+id/containerCountry"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Country" />

                    <Spinner
                        android:id="@+id/spCountry"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please select a country" />

                <!-- City Dropdown -->
                <LinearLayout
                    android:id="@+id/containerCity"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="City" />

                    <TextView
                        android:id="@+id/tvCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Choose City"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spCity"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivCityArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Dropdown Arrow" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please select a valid city" />

                <!-- Medical Condition Dropdown -->
                <LinearLayout
                    android:id="@+id/containerMedicalCondition"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        android:contentDescription="Medical Condition" />

                    <TextView
                        android:id="@+id/tvMedicalCondition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Choose Medical Condition"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spMedicalCondition"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivMedicalConditionArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Dropdown Arrow" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorMedicalCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚠ Please select a medical condition option" />

            </LinearLayout>

            <!-- Next Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_gradient"
                android:text="@string/next_btn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llForm" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Progress Overlay -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
