<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".activities.BodyVisualizationActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:rotation="180" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="3D Body Visualization"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tabs Profile: Front vs Side -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:background="#E2E8F0"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:id="@+id/tabFront"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvFrontText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Front View"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvSideText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Side View"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Body Visualization Outline Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBodyOutline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/cardZoneDetails"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivBodyOutline"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/success_illustration"
                app:layout_constraintBottom_toTopOf="@id/layoutZones"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Horizontal body zone selection tabs -->
            <LinearLayout
                android:id="@+id/layoutZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnZoneChest"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_margin="2dp"
                    android:background="#EEF2F6"
                    android:text="Chest"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnZoneAbs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_margin="2dp"
                    android:background="#EEF2F6"
                    android:text="Abs"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnZoneArms"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_margin="2dp"
                    android:background="#EEF2F6"
                    android:text="Arms"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnZoneLegs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_margin="2dp"
                    android:background="#EEF2F6"
                    android:text="Legs"
                    android:textColor="#475569"
                    android:textSize="11sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Region details Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardZoneDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBodyPartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abs Analysis"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMeasurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="14.5% Fat"
                android:textColor="#6C63FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBodyPartDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Abdominal core area shows increased tone. Recommended deficit is 150 kcal today."
                android:textColor="#475569"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
